# Copy to .env.local for local work. On Railway, set these in the service Variables tab.
SITE_URL=http://localhost:3000
DATA_DIR=./data
ADMIN_TOKEN=            # password for /admin/subscribers (long random string)
DOWNLOAD_SECRET=        # 32+ random chars; signs download and library links

# Prices in sen (RM 29.00 = 2900). Defaults sit inside the public ranges.
PRICE_MEMBANGUN_SEN=2900
PRICE_TEMAN_HIDUP_SEN=7900
BUMP_TEMAN_HIDUP_SEN=5000

# FPX + DuitNow QR (Billplz). Use https://www.billplz-sandbox.com for testing.
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE=
BILLPLZ_BASE_URL=https://www.billplz.com

# Cards (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Delivery
RESEND_API_KEY=
EMAIL_FROM=Perpustakaan Hati <buku@yourdomain.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=pesanan_siap
ASSETS_DIR=             # folder with edisi-membangun.pdf and teman-hidup.pdf (default DATA_DIR/assets)

# Demo mode: lets the whole buy -> deliver -> library flow run with NO provider keys.
# Fake payment page + a stamped placeholder PDF. Never set to 1 on the live site.
DEMO_MODE=0
